---
import Navbar from '../components/navbar.astro';
import Notification from '../components/notification.astro';
import '../css/calendar.css';
---

<Navbar />
<Notification />

<br/>
<br/>

<main class="calendar-main">
  <div class="calendar-header">
    <h2>My Calendar</h2>
    <button id="addEventBtn">Add Event</button>
  </div>

  <div class="calendar-grid">
    <div id="calendar"></div>
  </div>
</main>

<!-- Add Event Modal -->
<div id="addModal" class="modal-overlay hidden">
  <div class="modal">
    <h3>Add New Event</h3>
    <form id="eventForm">
      <label>Title</label>
      <input id="title" type="text" required />

      <label>Date</label>
      <input id="date" type="date" required />

      <label>Time</label>
      <input id="time" type="time" required />

      <label>Type</label>
      <select id="type">
        <option value="1">School</option>
        <option value="2">Work</option>
        <option value="3">Personal</option>
        <option value="4">Family</option>
      </select>

      <div class="modal-actions">
        <button type="submit">Add</button>
        <button type="button" id="cancelAdd">Cancel</button>
      </div>
    </form>
  </div>
</div>

<!-- Event Modal -->
<div id="removeModal" class="modal-overlay hidden">
  <div class="modal">
    <h2>Event Actions</h2>
    <div class="modal-actions">
      <button id="eventNotes">Note Sheet</button>
      <button id="confirmRemove">Remove Event</button>
      <button id="cancelRemove">Cancel</button>
    </div>
  </div>
</div>

<script>
  import { Calendar } from '@fullcalendar/core';
  import dayGridPlugin from '@fullcalendar/daygrid';

  let events = [];
  let user = null;
  let selectedEvent = null;

  const calendarEl = document.getElementById('calendar');
  const addModal = document.getElementById('addModal');
  const removeModal = document.getElementById('removeModal');
  const eventNotes = document.querySelector<HTMLButtonElement>("#eventNotes");

  const form = document.getElementById('eventForm');

  // FETCH USER
  async function fetchUser() {
    try {
      const res = await fetch('/api/get_user', { credentials: 'include' });
      const data = await res.json();
      if (res.ok)
        user = data.data;
    } catch (e) {
      console.error(e);
    }
  }

  // FETCH EVENTS
  async function fetchEvents() {
    try {
      const res = await fetch('/api/get_events', { credentials: 'include' });
      const data = await res.json();
      events = data.events || [];
      calendar.addEventSource(events);
    } catch (e) {
      console.error('Failed to fetch events', e);
    }
  }

  // CALENDAR INIT
  const calendar = new Calendar(calendarEl, {
    plugins: [dayGridPlugin],
    initialView: 'dayGridMonth',
    height: 'auto',
    events: [],
    eventClick(info) {
      selectedEvent = info.event;
      removeModal.classList.remove('hidden');
    }
  });

  calendar.render();

  // MODAL CONTROLS
  document.getElementById('addEventBtn').onclick = () => {
    addModal.classList.remove('hidden');
  };

  document.getElementById('cancelAdd').onclick = () => {
    addModal.classList.add('hidden');
  };

  document.getElementById('cancelRemove').onclick = () => {
    removeModal.classList.add('hidden');
    selectedEvent = null;
  };

  // ADD EVENT
  form.onsubmit = async (e) => {
    e.preventDefault();

    const title = document.getElementById('title').value;
    const date = document.getElementById('date').value;
    const time = document.getElementById('time').value;
    const type = document.getElementById('type').value;

    const fullDateTime = `${date}T${time}`;
    const commandId = crypto.randomUUID();

    const payload = {
      commandId,
      payload: { title, date: fullDateTime, type, time: fullDateTime }
    };

    try {
      const res = await fetch('/api/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        credentials: 'include'
      });

      if (!res.ok)
        throw new Error('Failed');

      const data = await res.json();

      const newEvent = {
        title,
        date: fullDateTime,
        id: data.eventId
      };

      calendar.addEvent(newEvent);

      if (user) {
        fetch('http://localhost:3001/add-notification', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text: title,
            status: 0,
            duration: 60000,
            scheduleTime: fullDateTime,
            userId: user.Uid
          })
        });
      }

      addModal.classList.add('hidden');
      form.reset();
    } catch (err) {
      alert('Failed to create event');
    }
  };

  // REMOVE EVENT
  document.getElementById('confirmRemove').onclick = async () => {
    if (!selectedEvent) return;

    const payload = {
      commandId: crypto.randomUUID(),
      payload: { Eid: selectedEvent.id }
    };

    try {
      const res = await fetch('/api/remove_event', {
        method: 'POST',
        body: JSON.stringify(payload)
      });

      if (!res.ok)
        throw new Error('Failed');

      window.location.reload();
    } catch (e) {
      console.error(e);
    }
  };

  // NAV TO NOTES
  eventNotes?.addEventListener('click', () => {globalThis.location.href = '/notes'})

  // -------------------------
  // INIT
  // -------------------------
  await fetchUser();
  await fetchEvents();
</script>
